DJANGO_SECRET_KEY=local-dev-secret-key-change-before-any-production-use
DJANGO_DEBUG=True
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:8095
# Multi-tenancy (subdomain per tenant). Leave both unset for local dev — the
# frontend falls back to sending an X-Tenant-Slug header instead of relying
# on a real subdomain. See backend/cases/middleware.py.
# MERIDIAN_ROOT_DOMAIN=meridianapp.com
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[\w-]+\.meridianapp\.com$
USE_REAL_OCR=False
USE_REAL_LLM=False
# Uncomment and set these when enabling real AWS services:
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION_NAME=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Real extraction with no AWS account: Tesseract (bundled in the backend
# Docker image) for OCR, the Anthropic API directly for LLM extraction.
USE_LOCAL_OCR=False
USE_ANTHROPIC_LLM=False
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
